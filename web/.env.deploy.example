# Vela PRODUCTION settings, used by `npm run deploy` and the *:deploy scripts.
# Copy to .env.deploy.local (git-ignored) and fill it in:  cp .env.deploy.example .env.deploy.local
# Never commit the filled-in file. Step-by-step guide: docs/DEPLOY.md.
# Every variable except those marked "deploy only" is pushed to Vercel (production).

# --- Database (Supabase -> Project Settings -> Database -> Connection string) ---
# Transaction pooler (port 6543), used by the app. URL-encode special characters in the password.
DATABASE_URL=postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres
# Session pooler (port 5432). Deploy only: used by migrations.
DATABASE_URL_SESSION=postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres
# Optional: PEM text of the provider's CA to verify the certificate (use \n for line breaks).
# DATABASE_SSL_CA=
# Optional: connections per serverless instance (default 3).
# DB_POOL_MAX=3

# --- Sessions ---
# 32+ random characters:  node -e "console.log(require('crypto').randomBytes(48).toString('base64'))"
SESSION_SECRET=

# --- Storage: Supabase Storage over its HTTP API (Project Settings -> API Keys) ---
STORAGE_DRIVER=supabase
SUPABASE_URL=https://<project-ref>.supabase.co
# The SECRET key (sb_secret_...). Server-side only; never put it in a NEXT_PUBLIC_ variable.
SUPABASE_SECRET_KEY=
# Public bucket for vendor photos/videos. The private bucket (vendor documents)
# defaults to "<bucket>-private"; npm run deploy creates both if missing.
STORAGE_BUCKET=vela-media
# STORAGE_PRIVATE_BUCKET=vela-media-private

# Not used by the app yet; kept for a future browser client.
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# --- Alternative storage: any S3-compatible API (Cloudflare R2, MinIO, Supabase S3, AWS) ---
# STORAGE_DRIVER=r2            # or s3
# S3_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
# S3_REGION=auto               # r2: auto; AWS: your region; Supabase S3: the project region
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
# S3_PUBLIC_URL=https://pub-<hash>.r2.dev   # public base URL of STORAGE_BUCKET (optional)

# --- Site ---
# Public origin for canonical links, robots.txt and sitemap.xml. Optional on
# Vercel (defaults to the project's production *.vercel.app domain).
# NEXT_PUBLIC_SITE_URL=https://your-domain.example

# --- Vercel (deploy only, all optional) ---
# VERCEL_PROJECT=vela
# VERCEL_SCOPE=<team-slug>
# VERCEL_TOKEN=               # only on machines where `npx vercel login` isn't possible (CI)
