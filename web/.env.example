# Copy this file to .env.local and fill in real values:  cp .env.example .env.local
# .env.local is git-ignored; never commit real credentials.
# npm run dev / build / start / db:migrate / db:seed / test:api / test:e2e all read .env.local.

# Local PostgreSQL. URL-encode special characters in the password. Use a separate database for automated tests, e.g. vela_test
# (db:seed only wipes a non-"_test" database when you pass --force).
DATABASE_URL=postgresql://postgres:CHANGE_ME@localhost:5432/vela_dev
# DATABASE_URL=postgresql://postgres:CHANGE_ME@localhost:5432/vela_test

# Secret used to sign session cookies (HS256). Must be at least 32 characters
# and must not be a placeholder; the app refuses to start with CHANGE_ME.
# Generate one with:  openssl rand -base64 48
#   or:  node -e "console.log(require('crypto').randomBytes(48).toString('base64'))"
SESSION_SECRET=CHANGE_ME

# Public base URL used for canonical/Open Graph links, robots.txt and sitemap.xml.
# Optional locally (defaults to http://localhost:3000); set it in production.
# NEXT_PUBLIC_SITE_URL=https://your-domain.example
