# Copy to .env.local and fill in. Never commit .env.local.

# --- Required ---
# Postgres connection string. On Neon use the *pooled* connection string
# (host contains "-pooler") so serverless functions don't exhaust connections.
DATABASE_URL=postgres://user:password@localhost:5432/vela_dev
# Long random string used to sign login cookies: openssl rand -base64 32
SESSION_SECRET=change-me-to-a-long-random-string

# --- Recommended in production ---
# Public URL of the site, used in links inside emails.
APP_URL=http://localhost:3000

# --- Optional: email (password reset, verification, notifications) ---
# Without RESEND_API_KEY, emails are printed to the server log instead.
RESEND_API_KEY=
EMAIL_FROM=Vela <onboarding@resend.dev>

# --- Optional: photo uploads (Cloudinary) ---
# Without these, vendors paste an image link instead of uploading a file.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# --- Optional ---
# Rate limits are on in production; set RATE_LIMIT=on to test them locally.
# RATE_LIMIT=on
