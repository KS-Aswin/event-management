{
  "compilerOptions": {
    "target": "ES2017",
    "lib": [
      "dom",
      "dom.iterable",
      "esnext"
    ],
    "allowJs": true,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "react-jsx",
    "incremental": true,
    "plugins": [
      {
        "name": "next"
      }
    ],
    "paths": {
      "@/*": [
        "./*"
      ]
    }
  },
  "include": [
    "next-env.d.ts",
    "**/*.ts",
    "**/*.tsx",
    ".next/types/**/*.ts",
    ".next/dev/types/**/*.ts",
    "**/*.mts",
    ".next-e2e/types/**/*.ts",
    ".next-e2e/dev/types/**/*.ts",
    ".next-build-v/types/**/*.ts",
    ".next-build-v/dev/types/**/*.ts",
    ".next-build-o/types/**/*.ts",
    ".next-build-o/dev/types/**/*.ts",
    ".next-build-m/types/**/*.ts",
    ".next-build-m/dev/types/**/*.ts",
    ".next-build-int/types/**/*.ts",
    ".next-build-int/dev/types/**/*.ts",
    ".next-e2e-int/types/**/*.ts",
    ".next-e2e-int/dev/types/**/*.ts",
    ".next-build/types/**/*.ts",
    ".next-build/dev/types/**/*.ts",
    ".next-build-d/types/**/*.ts",
    ".next-build-d/dev/types/**/*.ts",
    ".next-build-c/types/**/*.ts",
    ".next-build-c/dev/types/**/*.ts",
    ".next-build-b/types/**/*.ts",
    ".next-build-b/dev/types/**/*.ts",
    ".next-build-a/types/**/*.ts",
    ".next-build-a/dev/types/**/*.ts"
  ],
  "exclude": [
    "node_modules"
  ]
}
